PORT=5000
JWT_SECRET=your_jwt_secret_key_here
API_KEY=your_api_key_here
PAGE_LIMIT=20
OTP_EXPIRY=10 minutes
DEFAULT_JOB_TIMER=
PRODUCT_NAME=Testimonies.com
APP_THEME=default
NODE_ENV=development

# Email Setup
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_API_KEY=

# Frontend URLs
ADMIN_DASHBOARD_URL=http://localhost:5174
WEBSITE_URL=http://localhost:5173

# CORS (required – comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:3000

# API server public URL (optional). Used for startup console links.
# When deployed, set to e.g. https://api.yourdomain.com (no trailing slash)
# BASE_URL=https://api.yourdomain.com

# MongoDB
MONGO_URI=mongodb://localhost:27017/testimonies

# SMS / Twilio
SMS_BASE_URL=https://api.ng.termii.com
SMS_SENDER_ID=YourApp
SMS_API_KEY=your_termii_api_key
TWILIO_SMS_SENDER_ID=your_twilio_sid
TWILIO_SMS_API_KEY=your_twilio_auth_token
TWILIO_SMS_PHONE_NUMBER=+1234567890

# Cloudinary (profile image upload)
CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google APIS
GOOGLE_MAPS_API_KEY=

# MongoDB Atlas for Search Indexing
MONGODB_ATLAS_PROJECT_ID=
MONGODB_ATLAS_CLUSTER=
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_DATABASE=
MONGODB_TEAM_COLLECTION=
MONGODB_SEARCH_INDEX_LIMIT=

# OAUTH
GOOGLE_OATH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT=

# Clock in Distance
MAX_CLOCK_IN_DISTANCE=

# Security: set to true in production to redirect HTTP to HTTPS (omit if your reverse proxy does this)
ENFORCE_HTTPS_REDIRECT=false

# Payment Gateways
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=