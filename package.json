{
  "name": "testimonies-com-backend",
  "version": "1.0.0",
  "description": "Testimonies.com backend",
  "homepage": "https://github.com/Golden-Ogbeka/testimonies-com-backend#readme",
  "bugs": {
    "url": "https://github.com/Golden-Ogbeka/testimonies-com-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Golden-Ogbeka/testimonies-com-backend.git"
  },
  "license": "ISC",
  "author": "Golden Ogbeka",
  "main": "index.ts",
  "scripts": {
    "start": "tsc && node dist/index.js",
    "dev": "tsx watch src",
    "test": "jest --passWithNoTests",
    "type:check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "audit": "npm audit",
    "audit:ci": "npm audit --audit-level=moderate",
    "prepare": "simple-git-hooks",
    "precommit": "lint-staged && npm run type:check",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status"
  },
  "lint-staged": {
    "src/**/*.{ts,js,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npm run precommit"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-validator": "^3.0.0",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.0",
    "@types/nodemailer-express-handlebars": "^4.0.5",
    "@types/pdfkit": "^0.17.2",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.2.0",
    "lint-staged": "^16.1.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.13.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@sendgrid/mail": "^8.1.6",
    "agenda": "^5.0.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "colors": "^1.4.0",
    "company-email-validator": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "express": "^4.21.1",
    "express-handlebars": "^8.0.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^10.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "migrate-mongo": "^12.1.3",
    "moment": "^2.30.1",
    "mongodb": "^6.18.0",
    "mongoose": "^8.17.2",
    "mongoose-paginate-v2": "^1.9.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^7.0.5",
    "nodemailer-express-handlebars": "^7.0.0",
    "pdfkit": "^0.17.1",
    "socket.io": "^4.8.1",
    "stripe": "^20.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.8.0",
    "ua-parser-js": "^2.0.7",
    "urllib": "^4.8.2",
    "winston": "^3.19.0"
  }
}
